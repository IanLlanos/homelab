# Copy this file to .env and fill in the values.

# Discord bot token (Developer Portal > your app > Bot > Reset Token)
DISCORD_TOKEN=

# Channel where people post links (right-click the channel > Copy Channel ID)
CHANNEL_ID=

# Discord user IDs allowed to approve, comma-separated (right-click a user > Copy User ID)
AUTHORIZED_USER_IDS=

# Plex token, so finished downloads get scanned into Plex right away (leave blank to skip)
PLEX_TOKEN=

# Optional settings
# Sites people can request from (comma-separated)
#ALLOWED_DOMAINS=youtube.com,youtu.be,vimeo.com,twitter.com,x.com,reddit.com,redd.it,twitch.tv,tiktok.com,instagram.com,dailymotion.com,streamable.com
# Largest download allowed, in GB (0 = no limit)
#MAX_FILESIZE_GB=20
# Space to always leave free on a drive, in GB
#SPACE_MARGIN_GB=5
# Library folder names on each drive
#MOVIES_FOLDER=MOVIES
#TV_FOLDER=TV
