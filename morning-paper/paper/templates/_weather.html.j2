{% macro ear(box, side) %}
<div class="ear ear-{{ side }}">
  <div class="ear-label">Weather · {{ box.name }}</div>
  {% if box.ok and box.high is defined %}
    <div class="ear-temp">{{ box.high }}°<span class="ear-low"> / {{ box.low }}°</span></div>
    <div class="ear-cond">{{ box.today }}{% if box.rain %}, {{ box.rain }}% rain{% endif %}</div>
  {% elif box.ok %}
    <div class="ear-cond">{{ box.forecast|truncate(70) }}</div>
  {% else %}
    <div class="ear-cond">Forecast unavailable</div>
  {% endif %}
</div>
{% endmacro %}

{% macro detail(box) %}
<div class="wx">
  <h3 class="wx-name">{{ box.name }}</h3>
  <div class="wx-cols">
  <div class="wx-main">
  {% if box.alerts %}
    {% for a in box.alerts %}<p class="wx-alert">{{ a.event }}</p>{% endfor %}
  {% endif %}
  {% if box.ok and box.now is defined %}
    <p class="wx-now"><span class="wx-big">{{ box.now }}°</span> {{ box.conditions }}, feels like {{ box.feels }}°. Wind {{ box.wind }} mph, humidity {{ box.humidity }}%.</p>
  {% endif %}
  {% if box.forecast %}<p class="wx-text">{{ box.forecast }}</p>{% endif %}
  {% if box.days %}
  <table class="wx-days">
    {% for d in box.days %}
    <tr><th>{{ d.date|weekday }}</th><td>{{ d.conditions }}</td><td class="num">{{ d.high }}° / {{ d.low }}°</td><td class="num">{{ d.rain }}%</td></tr>
    {% endfor %}
  </table>
  {% endif %}
  {% if box.sunrise %}<p class="wx-sun">Sunrise {{ box.sunrise|hm12 }} · Sunset {{ box.sunset|hm12 }}</p>{% endif %}
  {% if not box.ok %}<p class="wx-text">The forecast could not be fetched this morning.</p>{% endif %}
  </div>
  {% if box.hours %}
  <figure class="wx-chart">
    <figcaption>Hour by Hour
      <span class="hc-key"><i class="k-temp"></i>Temperature <i class="k-feels"></i>Feels like <i class="k-rain"></i>Chance of rain</span>
    </figcaption>
    {{ box.hours|hourly_chart }}
    <p class="wx-sum">{{ box.hours|hourly_summary }}</p>
    <details class="wx-table">
      <summary>Every hour as a table</summary>
      <table class="wx-hours">
        <thead><tr><th>Hour</th><th>Sky</th><th class="num">Temp</th><th class="num">Feels</th><th class="num">Rain</th><th class="num">Wind</th></tr></thead>
        <tbody>
        {% for h in box.hours %}
        <tr{% if h.rain >= 50 %} class="wet"{% endif %}><th>{{ h.hour }}</th><td>{{ h.conditions }}</td><td class="num">{{ h.temp }}°</td><td class="num">{{ h.feels }}°</td><td class="num">{{ h.rain }}%</td><td class="num">{{ h.wind }}</td></tr>
        {% endfor %}
        </tbody>
      </table>
    </details>
  </figure>
  {% endif %}
  </div>
</div>
{% endmacro %}
